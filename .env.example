# Local development environment
# Uses hive-metastore and azurite from giga-dagster (giga-dataops network)

SHARED_SECRET=
ADMIN_AUTH=

# Hive Metastore - from giga-dagster
HIVE_METASTORE_URI=

# Azure Blob Storage - Azurite emulator from giga-dagster
# devstoreaccount1.blob.core.windows.net is a network alias for the azurite container
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCESS_KEY=

# Ingestion Portal DB - from giga-data-ingestion (db service on giga-dataops network)
INGESTIONPORTAL_PRODUCTION_DB_CONNECTION_URL=
INGESTIONPORTAL_PRODUCTION_USER=
INGESTIONPORTAL_PRODUCTION_PASSWORD=

# Taskfile vars (not used by Trino server directly)
TRINO_INGRESS_HOST=
TRINO_IMAGE_REPOSITORY=
